/* ==========================================================
   ElektroMeister Zürich — shared styles
   ========================================================== */

:root {
  --bg: #fafaf7;
  --bg-alt: #f3f2ed;
  --ink: #141414;
  --ink-2: #2a2a28;
  --muted: #6b6b66;
  --line: #e4e3dc;
  --line-strong: #d6d4ca;
  --accent: #f5a524;
  --accent-ink: #1a1407;

  --container: 1240px;
  --radius: 4px;

  --f-display: "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --f-body: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

body {
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.55;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

.container {
  width: 100%;
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 32px;
}

/* ---------- Type ---------- */
h1, h2, h3, h4 {
  font-family: var(--f-display);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.05;
  margin: 0;
  color: var(--ink);
  text-wrap: balance;
}
h1 { font-size: clamp(40px, 6vw, 76px); font-weight: 500; letter-spacing: -0.035em; }
h2 { font-size: clamp(28px, 3.6vw, 44px); letter-spacing: -0.025em; }
h3 { font-size: 20px; letter-spacing: -0.01em; font-weight: 600; }
p  { margin: 0; color: var(--ink-2); text-wrap: pretty; }

.eyebrow {
  font-family: var(--f-body);
  font-size: 12px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.eyebrow::before {
  content: "";
  width: 24px; height: 1px; background: var(--ink);
  display: inline-block;
}

.lead { font-size: 18px; color: var(--ink-2); max-width: 60ch; }

/* ---------- Header ---------- */
.site-header {
  position: sticky; top: 0; z-index: 50;
  background: rgba(250, 250, 247, 0.85);
  backdrop-filter: saturate(140%) blur(10px);
  -webkit-backdrop-filter: saturate(140%) blur(10px);
  border-bottom: 1px solid var(--line);
}
.nav {
  display: flex; align-items: center; justify-content: space-between;
  height: 72px;
}
.brand {
  display: inline-flex; align-items: center; gap: 12px;
  font-family: var(--f-display);
  font-weight: 600;
  font-size: 17px;
  letter-spacing: -0.01em;
}
.brand-mark {
  width: 28px; height: 28px;
  background: var(--ink);
  display: inline-flex; align-items: center; justify-content: center;
  position: relative;
}
.brand-mark::after {
  /* simple bolt: diamond split */
  content: "";
  width: 10px; height: 14px;
  background: var(--accent);
  clip-path: polygon(55% 0, 0 60%, 45% 60%, 30% 100%, 100% 38%, 55% 38%);
}
.brand small { color: var(--muted); font-weight: 400; font-size: 12px; letter-spacing: 0.04em; }

.nav-links {
  display: flex; gap: 36px; align-items: center;
  list-style: none; padding: 0; margin: 0;
}
.nav-links a {
  font-size: 14px; color: var(--ink-2);
  letter-spacing: 0.005em;
  position: relative; padding: 6px 0;
  transition: color .15s ease;
}
.nav-links a:hover { color: var(--ink); }
.nav-links a.active { color: var(--ink); }
.nav-links a.active::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -2px;
  height: 2px; background: var(--accent);
}

.nav-cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 14px; font-weight: 500;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 22px;
  border-radius: var(--radius);
  font-size: 15px; font-weight: 500;
  font-family: var(--f-body);
  letter-spacing: -0.005em;
  border: 1px solid transparent;
  cursor: pointer;
  transition: transform .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
  white-space: nowrap;
}
.btn-primary {
  background: var(--ink); color: var(--bg);
}
.btn-primary:hover { background: #000; }
.btn-secondary {
  background: transparent; color: var(--ink);
  border-color: var(--line-strong);
}
.btn-secondary:hover { border-color: var(--ink); }
.btn-accent {
  background: var(--accent); color: var(--accent-ink);
}
.btn-accent:hover { background: #e89a18; }
.btn .arrow { font-family: var(--f-display); transition: transform .15s ease; }
.btn:hover .arrow { transform: translateX(3px); }

/* ---------- Sections ---------- */
section { padding: 96px 0; }
section.tight { padding: 72px 0; }
.section-head {
  display: grid; grid-template-columns: 1fr 2fr; gap: 64px;
  margin-bottom: 56px; align-items: end;
}
.section-head .right { color: var(--ink-2); max-width: 56ch; }
@media (max-width: 800px) {
  .section-head { grid-template-columns: 1fr; gap: 24px; margin-bottom: 40px; }
  section { padding: 64px 0; }
}

/* ---------- Hero ---------- */
.hero {
  padding: 96px 0 120px;
  border-bottom: 1px solid var(--line);
}
.hero-grid {
  display: grid; grid-template-columns: 1.4fr 1fr; gap: 72px;
  align-items: end;
}
.hero h1 .accent-word {
  font-style: italic;
  font-weight: 400;
  color: var(--ink);
  position: relative;
}
.hero h1 .accent-word::after {
  content: "";
  display: block;
  height: 8px; width: 100%;
  background: var(--accent);
  margin-top: 4px;
  transform-origin: left;
}
.hero-meta {
  display: flex; flex-direction: column; gap: 28px;
}
.hero-meta p { font-size: 17px; }
.hero-cta-row {
  display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px;
}
.hero-visual {
  margin-top: 56px;
  height: 360px;
  border: 1px solid var(--line);
  background:
    repeating-linear-gradient(135deg,
      transparent 0 14px,
      rgba(20,20,20,0.04) 14px 15px);
  background-color: var(--bg-alt);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.hero-visual .ph-label {
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  font-size: 12px; color: var(--muted);
  letter-spacing: 0.04em;
  background: var(--bg);
  padding: 6px 10px; border: 1px solid var(--line);
}
.hero-visual .corner-tag {
  position: absolute; top: 16px; left: 16px;
  font-family: ui-monospace, monospace;
  font-size: 11px; color: var(--muted);
  letter-spacing: 0.08em;
}
.hero-visual .corner-tag-r {
  position: absolute; bottom: 16px; right: 16px;
  font-family: ui-monospace, monospace;
  font-size: 11px; color: var(--muted);
  letter-spacing: 0.08em;
}

@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; gap: 32px; }
  .hero { padding: 56px 0 72px; }
  .hero-visual { height: 240px; margin-top: 32px; }
}

/* ---------- Trust bar ---------- */
.trust {
  background: var(--ink);
  color: var(--bg);
  padding: 56px 0;
}
.trust-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
.trust-item {
  padding: 8px 24px;
  border-left: 1px solid rgba(255,255,255,0.12);
}
.trust-item:first-child { border-left: none; padding-left: 0; }
.trust-num {
  font-family: var(--f-display);
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 500;
  letter-spacing: -0.035em;
  line-height: 1;
  color: var(--bg);
}
.trust-num em {
  font-style: normal;
  color: var(--accent);
}
.trust-label {
  margin-top: 12px;
  font-size: 14px;
  color: rgba(250,250,247,0.65);
}
@media (max-width: 700px) {
  .trust-grid { grid-template-columns: 1fr; gap: 32px; }
  .trust-item { border-left: none; padding: 0; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 24px; }
  .trust-item:first-child { border-top: none; padding-top: 0; }
}

/* ---------- Services preview / grid ---------- */
.services-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}
.service-card {
  background: var(--bg);
  padding: 36px 32px 32px;
  display: flex; flex-direction: column; gap: 20px;
  min-height: 280px;
  transition: background .2s ease;
  position: relative;
}
.service-card:hover { background: #fff; }
.service-card .icon {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid var(--ink);
  color: var(--ink);
}
.service-card h3 { font-size: 22px; font-weight: 500; letter-spacing: -0.015em; }
.service-card p { font-size: 15px; color: var(--ink-2); }
.service-card .more {
  margin-top: auto;
  font-size: 14px; font-weight: 500;
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--ink);
}
.service-card .more::after {
  content: "→"; transition: transform .15s ease;
}
.service-card:hover .more::after { transform: translateX(3px); }
.service-card .num {
  position: absolute; top: 16px; right: 20px;
  font-family: ui-monospace, monospace;
  font-size: 11px; color: var(--muted); letter-spacing: 0.05em;
}

@media (max-width: 900px) {
  .services-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .services-grid { grid-template-columns: 1fr; }
}

/* ---------- Testimonials ---------- */
.testimonials-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
}
.testimonial {
  background: var(--bg);
  border: 1px solid var(--line);
  padding: 32px;
  display: flex; flex-direction: column; gap: 24px;
  min-height: 260px;
}
.testimonial blockquote {
  margin: 0;
  font-family: var(--f-display);
  font-size: 19px; line-height: 1.4;
  letter-spacing: -0.01em;
  color: var(--ink);
  font-weight: 400;
}
.testimonial blockquote::before {
  content: "“";
  font-family: var(--f-display);
  display: block;
  font-size: 48px; line-height: 0.5;
  color: var(--accent);
  margin-bottom: 16px;
}
.testimonial-meta {
  margin-top: auto;
  display: flex; align-items: center; gap: 12px;
  border-top: 1px solid var(--line);
  padding-top: 20px;
}
.avatar {
  width: 40px; height: 40px;
  background: var(--bg-alt);
  border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-display);
  font-size: 14px; font-weight: 500;
  color: var(--ink);
}
.testimonial-name { font-size: 14px; font-weight: 500; }
.testimonial-role { font-size: 13px; color: var(--muted); }

@media (max-width: 900px) {
  .testimonials-grid { grid-template-columns: 1fr; }
}

/* ---------- CTA banner ---------- */
.cta-banner {
  background: var(--ink);
  color: var(--bg);
  padding: 80px 0;
}
.cta-banner-grid {
  display: grid; grid-template-columns: 1.5fr 1fr;
  gap: 48px; align-items: end;
}
.cta-banner h2 { color: var(--bg); max-width: 16ch; }
.cta-banner p { color: rgba(250,250,247,0.7); margin-top: 20px; }
.cta-banner .actions { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }
.cta-banner .btn-secondary { color: var(--bg); border-color: rgba(255,255,255,0.25); }
.cta-banner .btn-secondary:hover { border-color: var(--bg); }

@media (max-width: 800px) {
  .cta-banner-grid { grid-template-columns: 1fr; }
  .cta-banner .actions { justify-content: flex-start; }
}

/* ---------- Footer ---------- */
.site-footer {
  background: var(--bg);
  border-top: 1px solid var(--line);
  padding: 64px 0 32px;
}
.footer-grid {
  display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 48px;
  padding-bottom: 56px;
}
.footer-grid h4 {
  font-family: var(--f-body);
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 20px;
}
.footer-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
.footer-grid a, .footer-grid li { font-size: 14px; color: var(--ink-2); }
.footer-grid a:hover { color: var(--ink); }
.footer-brand p { font-size: 14px; max-width: 32ch; color: var(--muted); margin-top: 16px; }
.footer-bottom {
  border-top: 1px solid var(--line);
  padding-top: 24px;
  display: flex; justify-content: space-between; align-items: center;
  font-size: 13px; color: var(--muted);
  flex-wrap: wrap; gap: 16px;
}

@media (max-width: 900px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
}
@media (max-width: 560px) {
  .footer-grid { grid-template-columns: 1fr; }
}

/* ---------- Page header (interior pages) ---------- */
.page-header {
  padding: 80px 0 72px;
  border-bottom: 1px solid var(--line);
}
.page-header-grid {
  display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: end;
}
.page-header h1 { font-size: clamp(40px, 5.5vw, 68px); }
.page-header p { font-size: 17px; max-width: 50ch; }
.breadcrumb {
  font-family: ui-monospace, monospace;
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.06em;
  margin-bottom: 28px;
  text-transform: uppercase;
}
.breadcrumb span { color: var(--ink); }
@media (max-width: 800px) {
  .page-header-grid { grid-template-columns: 1fr; gap: 24px; }
  .page-header { padding: 48px 0; }
}

/* ---------- About / team ---------- */
.story-grid {
  display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px;
  align-items: start;
}
.story-grid p + p { margin-top: 18px; }
.story-image {
  height: 420px;
  background: var(--bg-alt);
  background-image: repeating-linear-gradient(135deg,
    transparent 0 18px,
    rgba(20,20,20,0.04) 18px 19px);
  border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.story-image .ph-label {
  font-family: ui-monospace, monospace;
  font-size: 12px; color: var(--muted);
  background: var(--bg); padding: 6px 10px; border: 1px solid var(--line);
}
@media (max-width: 800px) {
  .story-grid { grid-template-columns: 1fr; gap: 32px; }
  .story-image { height: 240px; }
}

.team-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
}
.team-card {
  background: var(--bg);
  border: 1px solid var(--line);
  padding: 0;
  display: flex; flex-direction: column;
}
.team-portrait {
  height: 280px;
  background: var(--bg-alt);
  background-image: repeating-linear-gradient(135deg,
    transparent 0 14px,
    rgba(20,20,20,0.04) 14px 15px);
  border-bottom: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-display);
  font-size: 64px; font-weight: 500;
  color: rgba(20,20,20,0.18);
  letter-spacing: -0.04em;
}
.team-info { padding: 20px 24px 24px; }
.team-name { font-family: var(--f-display); font-size: 19px; font-weight: 500; letter-spacing: -0.015em; }
.team-role { font-size: 14px; color: var(--muted); margin-top: 4px; }
.team-bio { font-size: 14px; color: var(--ink-2); margin-top: 14px; line-height: 1.55; }

@media (max-width: 900px) {
  .team-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .team-grid { grid-template-columns: 1fr; }
}

/* values */
.values-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}
.value {
  background: var(--bg);
  padding: 32px 28px;
  display: flex; flex-direction: column; gap: 12px;
  min-height: 200px;
}
.value-num {
  font-family: ui-monospace, monospace;
  font-size: 12px; color: var(--accent); letter-spacing: 0.08em;
}
.value h3 { font-size: 19px; font-weight: 500; letter-spacing: -0.015em; }
.value p { font-size: 14px; }
@media (max-width: 900px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 500px) { .values-grid { grid-template-columns: 1fr; } }

/* certifications */
.certs {
  display: flex; flex-wrap: wrap; gap: 16px;
  margin-top: 48px;
}
.cert {
  display: inline-flex; align-items: center; gap: 12px;
  padding: 14px 18px;
  border: 1px solid var(--line);
  background: var(--bg);
  font-size: 14px;
}
.cert-mark {
  width: 28px; height: 28px;
  background: var(--ink); color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-display);
  font-size: 14px; font-weight: 600;
}

/* ---------- Contact page ---------- */
.contact-grid {
  display: grid; grid-template-columns: 1.1fr 1fr; gap: 72px;
  align-items: start;
}
@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; gap: 48px; }
}

.form {
  display: flex; flex-direction: column; gap: 22px;
}
.field { display: flex; flex-direction: column; gap: 8px; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.field label {
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted);
}
.field input, .field textarea {
  font-family: var(--f-body);
  font-size: 16px;
  color: var(--ink);
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--line-strong);
  padding: 10px 0;
  border-radius: 0;
  transition: border-color .15s ease;
  outline: none;
  resize: vertical;
}
.field input:focus, .field textarea:focus {
  border-bottom-color: var(--ink);
}
.field input::placeholder, .field textarea::placeholder { color: #b5b3aa; }
.form-actions { display: flex; align-items: center; gap: 16px; margin-top: 8px; }
.form-note { font-size: 13px; color: var(--muted); }
.form-success {
  display: none;
  padding: 16px 20px;
  background: var(--ink); color: var(--bg);
  font-size: 14px;
  border-left: 3px solid var(--accent);
}
.form-success.show { display: block; }
@media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }

.contact-info {
  display: flex; flex-direction: column; gap: 28px;
}
.info-block {
  display: grid; grid-template-columns: 120px 1fr;
  gap: 24px;
  padding: 20px 0;
  border-top: 1px solid var(--line);
}
.info-block:last-child { border-bottom: 1px solid var(--line); }
.info-block dt {
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted); font-weight: 500; padding-top: 4px;
}
.info-block dd {
  margin: 0; font-size: 16px; color: var(--ink); line-height: 1.55;
}
.info-block dd a:hover { color: var(--accent-ink); border-bottom: 1px solid var(--accent); }

/* fake map */
.map-block {
  margin-top: 48px;
  height: 360px;
  border: 1px solid var(--line);
  position: relative;
  overflow: hidden;
  background: #ecebe5;
}
.map-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(20,20,20,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(20,20,20,0.06) 1px, transparent 1px);
  background-size: 48px 48px;
}
.map-roads {
  position: absolute; inset: 0;
}
.map-roads::before, .map-roads::after {
  content: "";
  position: absolute;
  background: rgba(255,255,255,0.85);
}
.map-roads::before {
  left: 0; right: 0; top: 42%; height: 18px;
  transform: rotate(-3deg);
}
.map-roads::after {
  top: 0; bottom: 0; left: 38%; width: 14px;
  transform: rotate(2deg);
}
.map-water {
  position: absolute;
  right: -40px; bottom: -60px;
  width: 320px; height: 220px;
  background: #d8e3e8;
  border-radius: 60% 30% 50% 40%;
  transform: rotate(-12deg);
  opacity: 0.75;
}
.map-pin {
  position: absolute;
  top: 38%; left: 44%;
  transform: translate(-50%, -100%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  z-index: 2;
}
.map-pin .dot {
  width: 16px; height: 16px;
  background: var(--accent);
  border: 3px solid var(--ink);
  border-radius: 50%;
  box-shadow: 0 4px 0 -2px rgba(20,20,20,0.2);
}
.map-pin .label {
  background: var(--ink); color: var(--bg);
  padding: 6px 10px;
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.map-attrib {
  position: absolute;
  bottom: 8px; right: 12px;
  font-family: ui-monospace, monospace;
  font-size: 10px; color: var(--muted);
  letter-spacing: 0.05em;
  background: rgba(255,255,255,0.7);
  padding: 2px 6px;
}

/* ---------- mobile nav ---------- */
.menu-btn {
  display: none;
  background: transparent; border: none; cursor: pointer;
  padding: 8px;
}
.menu-btn span {
  display: block; width: 22px; height: 1.5px; background: var(--ink); margin: 5px 0;
}
@media (max-width: 800px) {
  .nav-links { display: none; }
  .nav-cta { display: none; }
  .menu-btn { display: block; }
  .nav-links.open {
    display: flex; flex-direction: column;
    position: absolute; top: 72px; left: 0; right: 0;
    background: var(--bg); border-bottom: 1px solid var(--line);
    padding: 24px 32px; gap: 20px;
  }
}

/* ---------- helpers ---------- */
.divider { height: 1px; background: var(--line); width: 100%; }
.bg-alt { background: var(--bg-alt); }

/* small icons (svg) */
.icon svg { width: 22px; height: 22px; }
